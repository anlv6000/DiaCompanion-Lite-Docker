index 0000000..ea59a9b
--- /dev/null
+++ b/Lite/tests/lite.smoke.test.tsx
@@ -0,0 +1,63 @@
+// @vitest-environment jsdom
+import { describe, it, expect, beforeEach, vi } from "vitest";
+import { render, screen, waitFor } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { AuthProvider } from "@/contexts/AuthContext";
+import { DataProvider } from "@/contexts/DataContext";
+import { ToastProvider } from "@/contexts/ToastContext";
+import { LiteRoutes } from "@/lite/LiteRoutes";
+
+const patient = { id: 7, code: "BN001", fullName: "Nguyen Van A", age: 55, gender: 0, phone: "0912345678", diabetesType: 2, diabetesDurationYears: 8, baselineHbA1c: 8.1, latestDrGrade: null, latestVisitDate: null, hasAccount: false, dateOfBirth: "1970-01-01", createdAt: "2026-01-01T00:00:00Z", visitCount: 1, rowVersion: "AA==" };
+const paged = (items: any[]) => ({ items, page: 1, pageSize: 25, totalItems: items.length, totalPages: 1, rangeLabel: "1–1 / 1" });
+const visit = { id: 11, patientId: 7, patientName: "x", patientCode: "BN001", doctorId: 1, visitDate: "2026-09-20T01:00:00Z", status: 0, imageCount: 1, pendingReviewCount: 1, rowVersion: "AA==" };
+const img = { id: 21, patientId: 7, visitId: 11, eye: 0, qualityStatus: 1, createdAt: "2026-09-20T01:00:00Z", rowVersion: "AA==" };
+const dx = { id: 31, fundusImageId: 21, eye: 0, drGrade: 0, drGradeLabel: "Normal", lesionGradeImplied: 3, disagreement: 0.75, effectiveDisagreementThreshold: 0.35, clinicalRiskScore: 0, countMA: 0, countHE: 0, countEX: 55, countSE: 0, isDeferred: true, deferReasonLabel: "Bất đồng cao", hasLesionMask: true, hasFractalImage: true, createdAt: "2026-09-20T01:05:00Z", isConfirmed: false };
+const calls: string[] = [];
+function route(url: string, init?: any) {
+  const path = url.replace(/^https?:\/\/[^/]+/, "");
+  calls.push((init?.method || "GET") + " " + path);
+  if (path.startsWith("/api/patients?")) return paged([patient]);
+  if (path === "/api/patients/7") return patient;
+  if (path.startsWith("/api/visits?")) return paged([visit]);
+  if (path === "/api/visits/11/health-metrics") return { visitId: 11 };
+  if (path.startsWith("/api/images?")) return [img];
+  if (path === "/api/images/21/content") return null;
+  if (path === "/api/diagnoses/by-image/21") return [dx];
+  return {};
+}
+beforeEach(() => {
+  calls.length = 0;
+  sessionStorage.setItem("diacompanion.token", "t");
+  sessionStorage.setItem("diacompanion.user", JSON.stringify({ userId: 1, fullName: "NCV", roles: ["Doctor", "Receptionist"], mustChangePassword: false, defaultRoute: "/triage" }));
+  (globalThis as any).fetch = vi.fn(async (url: string, init: any) => {
+    const body = route(String(url), init);
+    if (String(url).includes("/content")) return new Response(new Blob(["x"]), { status: 200 });
+    return new Response(JSON.stringify(body), { status: 200, headers: { "Content-Type": "application/json" } });
+  });
+  (URL as any).createObjectURL = () => "blob:x"; (URL as any).revokeObjectURL = () => {};
+});
+const app = (path: string) => render(<MemoryRouter initialEntries={[path]}><AuthProvider><DataProvider><ToastProvider><LiteRoutes /></ToastProvider></DataProvider></AuthProvider></MemoryRouter>);
+
+describe("Lite smoke", () => {
+  it("legacy landing /triage redirects to the patient list", async () => {
+    app("/triage");
+    await screen.findByText("BN001");
+    expect(screen.getByText("Thêm bệnh nhân", { selector: "button" })).toBeTruthy();
+    expect(calls.some((c) => c.includes("/api/engagement") || c.includes("/api/triage"))).toBe(false);
+  });
+  it("case workspace shows metrics, both eyes, AI summary and close panel", async () => {
+    app("/cases/7");
+    await screen.findByText(/1\. Chỉ số lâm sàng/);
