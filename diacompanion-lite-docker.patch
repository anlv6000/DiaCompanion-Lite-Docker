+++ b/Lite/export_dataset.sql
@@ -0,0 +1,55 @@
+/* Xuất bộ dữ liệu nghiên cứu: MỘT DÒNG = một lần chạy AI của một mắt (đã loại bản ghi void).
+   ĐÃ BỎ mọi trường định danh (họ tên, SĐT, ngày sinh, địa chỉ) — chỉ giữ mã bệnh nhân và tuổi.
+   Chạy trong SSMS rồi "Save Results As… CSV", hoặc:
+     sqlcmd -S <server> -d DiaCompanion -W -s "," -i export_dataset.sql -o dataset.csv
+   Tên bảng/cột lấy từ Entities + Report 4; CHƯA chạy thử trên SQL Server — kiểm tra trước khi dùng. */
+SELECT
+    p.Code                                              AS PatientCode,
+    p.Gender,
+    DATEDIFF(YEAR, p.DateOfBirth, v.VisitDate)          AS AgeAtVisit,
+    p.DiabetesType,
+    p.DiabetesDurationYears,
+    p.BaselineHbA1c,
+    v.Id                                                AS VisitId,
+    v.VisitDate,
+    v.Status                                            AS VisitStatus,
+    v.RecheckMonths,
+    (SELECT TOP 1 m.Value FROM dbo.HealthMetrics m WHERE m.VisitId = v.Id AND m.MetricType = 2 AND m.IsDeleted = 0 ORDER BY m.Id DESC) AS VisitHbA1c,
+    (SELECT TOP 1 m.Value FROM dbo.HealthMetrics m WHERE m.VisitId = v.Id AND m.MetricType = 1 AND m.IsDeleted = 0 ORDER BY m.Id DESC) AS VisitGlucose_mmolL,
+    (SELECT TOP 1 m.Value FROM dbo.HealthMetrics m WHERE m.VisitId = v.Id AND m.MetricType = 3 AND m.IsDeleted = 0 ORDER BY m.Id DESC) AS VisitSystolicBp,
+    (SELECT TOP 1 m.Value FROM dbo.HealthMetrics m WHERE m.VisitId = v.Id AND m.MetricType = 4 AND m.IsDeleted = 0 ORDER BY m.Id DESC) AS VisitDiastolicBp,
+    i.Id                                                AS ImageId,
+    CASE i.Eye WHEN 0 THEN 'OD' ELSE 'OS' END           AS Eye,
+    i.QualityStatus,                                    -- 0 chờ duyệt, 1 đạt, 2 không đạt
+    d.Id                                                AS DiagnosisId,
+    d.CreatedAt                                         AS AiRunAtUtc,
+    d.DrGrade                                           AS AiGrade,
+    d.LesionGradeImplied,
+    d.CountMA, d.CountHE, d.CountEX, d.CountSE,
+    d.AreaMA,  d.AreaHE,  d.AreaEX,  d.AreaSE,
+    d.Disagreement,
+    d.ClinicalRiskScore,
+    d.ClinicalRiskFactors,
+    d.EffectiveDisagreementThreshold,
+    d.IsDeferred,
+    d.DeferReason,
+    d.FractalDimension, d.FractalSt, d.FractalSn, d.FractalIt, d.FractalIn,
+    d.FractalAsymmetry, d.FractalTn, d.Lacunarity,
+    mvDr.Name                                           AS DrModelVersion,
+    mvLe.Name                                           AS LesionModelVersion,
+    mvFr.Name                                           AS FractalModelVersion,
+    r.Action                                            AS ReviewAction,   -- 0 phê duyệt, 1 ghi đè
+    r.FinalGrade                                        AS DoctorGrade,    -- phân độ tham chiếu của bác sĩ
+    r.Reason                                            AS OverrideReason,
+    r.CreatedAt                                         AS ReviewedAtUtc
+FROM dbo.AiDiagnoses d
+JOIN dbo.FundusImages   i  ON i.Id = d.FundusImageId
+JOIN dbo.MedicalVisits  v  ON v.Id = i.VisitId
+JOIN dbo.MedicalRecords mr ON mr.Id = v.MedicalRecordId
+JOIN dbo.Patients       p  ON p.Id = mr.PatientId
+LEFT JOIN dbo.DiagnosisReviews r ON r.AiDiagnosisId = d.Id AND r.IsVoided = 0
+LEFT JOIN dbo.ModelVersions mvDr ON mvDr.Id = d.ModelVersionId
+LEFT JOIN dbo.ModelVersions mvLe ON mvLe.Id = d.LesionModelVersionId
+LEFT JOIN dbo.ModelVersions mvFr ON mvFr.Id = d.FractalModelVersionId
+WHERE d.IsVoided = 0 AND i.IsVoided = 0 AND v.IsVoided = 0 AND p.IsVoided = 0
+ORDER BY p.Code, v.VisitDate, i.Eye, d.CreatedAt;
