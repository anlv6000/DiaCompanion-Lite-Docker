--- /dev/null
+++ b/docker-compose.yml
@@ -0,0 +1,116 @@
+# DiaCompanion Lite — toàn bộ hệ thống trong một lệnh:
+#   1) cp .env.example .env   (hoặc chạy docker/generate-env.ps1 | .sh)  rồi sửa giá trị
+#   2) đặt trọng số AI vào ./ai-weights/model_1 | model_2 | model_3
+#   3) docker compose up -d --build
+#   4) mở http://localhost:${WEB_PORT}   — mật khẩu tạm ở ./secrets/initial_credentials.txt
+name: diacompanion-lite
+
+x-restart: &restart
+  restart: unless-stopped
+
+services:
+  db:
+    <<: *restart
+    image: mcr.microsoft.com/mssql/server:2022-latest
+    environment:
+      ACCEPT_EULA: "Y"
+      MSSQL_PID: Express            # miễn phí, giới hạn 10 GB/DB — đủ cho thu thập dữ liệu
+      MSSQL_SA_PASSWORD: ${MSSQL_SA_PASSWORD:?Đặt MSSQL_SA_PASSWORD trong .env}
+      TZ: Asia/Ho_Chi_Minh
+    volumes:
+      - mssql_data:/var/opt/mssql
+    healthcheck:
+      test: ["CMD-SHELL", "/opt/mssql-tools18/bin/sqlcmd -C -S localhost -U sa -P \"$$MSSQL_SA_PASSWORD\" -Q 'SELECT 1' >/dev/null || exit 1"]
+      interval: 10s
+      timeout: 5s
+      retries: 30
+      start_period: 30s
+    # Không mở cổng 1433 ra ngoài. Cần SSMS từ máy chủ thì bỏ comment dòng dưới:
+    # ports: ["127.0.0.1:1433:1433"]
+
+  dbinit:
+    build:
+      context: .
+      dockerfile: docker/backend/Dockerfile
+      target: dbinit
+    restart: "no"
+    depends_on:
+      db:
+        condition: service_healthy
+    environment:
+      MSSQL_SA_PASSWORD: ${MSSQL_SA_PASSWORD}
+      LITE_ADMIN_EMAIL: ${LITE_ADMIN_EMAIL:-nghiencuu@benhvien.local}
+      LITE_ADMIN_NAME: ${LITE_ADMIN_NAME:-Nghiên cứu viên}
+      LITE_LICENSE: ${LITE_LICENSE:-NCKH-001}
+      ALLOW_MISSING_WEIGHTS: ${ALLOW_MISSING_WEIGHTS:-0}
+    volumes:
+      # seed_lite.py băm trọng số để ghi vào bảng ModelVersions.
+      - ./ai-weights/model_1:/ai_service/models/model_1/weights:ro
+      - ./ai-weights/model_2:/ai_service/models/model_2/weights:ro
+      - ./ai-weights/model_3:/ai_service/models/model_3/weights:ro
+      - ./secrets:/secrets
+      - ./exports:/exports
+
+  ai:
+    <<: *restart
+    build:
+      context: .
+      dockerfile: docker/ai/Dockerfile
+    volumes:
+      - storage:/data/storage
+      - ./ai-weights/model_1:/app/models/model_1/weights:ro
+      - ./ai-weights/model_2:/app/models/model_2/weights:ro
+      - ./ai-weights/model_3:/app/models/model_3/weights:ro
+    healthcheck:
+      test: ["CMD", "python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)"]
+      interval: 15s
+      timeout: 6s
+      retries: 10
+      start_period: 60s
+
+  backend:
+    <<: *restart
+    build:
+      context: .
+      dockerfile: docker/backend/Dockerfile
+      target: runtime
+    depends_on:
+      dbinit:
+        condition: service_completed_successfully
+      ai:
+        condition: service_started
+    environment:
+      ASPNETCORE_ENVIRONMENT: Production
+      ConnectionStrings__Default: "Server=db;Database=DiaCompanion;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;Encrypt=True"
+      Jwt__SigningKey: ${JWT_SIGNING_KEY:?Đặt JWT_SIGNING_KEY trong .env}
+      Jwt__Issuer: diacompanion
+      Jwt__Audience: diacompanion-web
+      Storage__FundusRoot: /data/storage/fundus
+      Storage__AiMasksRoot: /data/storage/ai_masks
+      AiService__BaseUrl: http://ai:8000
+      AiService__TimeoutSeconds: "300"
+      Clinic__TimeZone: Asia/Ho_Chi_Minh
+      TZ: Asia/Ho_Chi_Minh
+    volumes:
+      - storage:/data/storage
+    healthcheck:
+      test: ["CMD-SHELL", "bash -c 'exec 3<>/dev/tcp/127.0.0.1/8080 && printf \"GET /health HTTP/1.0\\r\\n\\r\\n\" >&3 && grep -q healthy <&3'"]
+      interval: 10s
+      timeout: 5s
+      retries: 20
+      start_period: 20s
+
+  web:
+    <<: *restart
+    build:
+      context: .
+      dockerfile: docker/web/Dockerfile
+    depends_on:
+      backend:
+        condition: service_healthy
+    ports:
+      - "${WEB_PORT:-8080}:80"
+
+volumes:
+  mssql_data:
+  storage:
diff --git a/docker/ai/Dockerfile b/docker/ai/Dockerfile
new file mode 100644
index 0000000..80a881a
--- /dev/null
+++ b/docker/ai/Dockerfile
@@ -0,0 +1,41 @@
+# syntax=docker/dockerfile:1.6
+# Dịch vụ AI (FastAPI + 3 model). Build context = thư mục gốc repo.
+# Chạy CPU. Trọng số KHÔNG nằm trong image: gắn volume vào /app/models/model_N/weights.
+FROM python:3.11-slim
+
+# libgl1 + libglib2.0-0: cần cho opencv-python (bản không headless) trên image slim.
+RUN apt-get update \
+ && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
+ && rm -rf /var/lib/apt/lists/*
+
+WORKDIR /app
+ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONUNBUFFERED=1
+
+# Phiên bản TensorFlow: model_3 nạp tệp .keras bằng tf.keras.models.load_model.
+# 2.15 (Keras 2.15) là bản thấp nhất mà requirements.txt cho phép; đổi bằng
+#   docker compose build --build-arg TF_VERSION=2.16.2 ai
+# nếu model của bạn được huấn luyện bằng Keras 3.
+ARG TF_VERSION=2.15.1
+# TensorFlow 2.15 cần numpy < 2.
+RUN printf 'numpy<2\n' > /constraints.txt
+COPY ai_service/requirements.txt /tmp/requirements.txt
+RUN pip install --constraint /constraints.txt torch torchvision --index-url https://download.pytorch.org/whl/cpu \
+ && pip install --constraint /constraints.txt "tensorflow-cpu==${TF_VERSION}" \
+ && grep -v -i -E '^(torch|torchvision|tensorflow)([<>=!~ ]|$)' /tmp/requirements.txt > /tmp/rest.txt \
+ && pip install --constraint /constraints.txt -r /tmp/rest.txt
+
+COPY ai_service/app.py ai_service/model_runners.py ./
+COPY ai_service/models/model_1/predict.py models/model_1/predict.py
+COPY ai_service/models/model_2/predict.py models/model_2/predict.py
+COPY ai_service/models/model_3/predict.py models/model_3/predict.py
+
+# UID 1654 trùng người dùng "app" của image backend (chung volume ảnh).
+RUN useradd --uid 1654 --no-create-home --shell /usr/sbin/nologin app \
+ && mkdir -p /data/storage && chown -R 1654:1654 /data /app
+USER 1654
+
+# FUNDUS_ROOT = thư mục CHA của "fundus" (backend lưu đường dẫn dạng fundus/2026/…).
+ENV FUNDUS_ROOT=/data/storage \
+    MASK_OUTPUT_ROOT=/data/storage/ai_masks
+EXPOSE 8000
+CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
diff --git a/docker/backend/Dockerfile b/docker/backend/Dockerfile
new file mode 100644
index 0000000..8185954
--- /dev/null
+++ b/docker/backend/Dockerfile
@@ -0,0 +1,61 @@
+# syntax=docker/dockerfile:1.6
+# Build context = thư mục gốc repo.  Ba target:
+#   runtime : ASP.NET Core 8 backend
+#   dbinit  : tạo DB, áp schema, seed tài khoản + model, xuất dữ liệu (sqlcmd + python)
+#   (schema : stage trung gian sinh schema.sql)
+
+############################ build ############################
+FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
+WORKDIR /src
+COPY Backend/DiaCompanion/DiaCompanion.csproj DiaCompanion/
+RUN dotnet restore DiaCompanion/DiaCompanion.csproj
+COPY Backend/DiaCompanion/ DiaCompanion/
+RUN dotnet publish DiaCompanion/DiaCompanion.csproj -c Release -o /app --no-restore
+
+############################ schema ###########################
+# Ưu tiên tệp Backend/DiaCompanion/Database/lite_schema.sql nếu bạn tự đặt vào
+# (xuất từ DB đang chạy của bạn — sát bản thật nhất). Nếu không có, sinh DDL từ
+# chính mô hình EF Core (AppDbContext) bằng `dotnet ef dbcontext script`.
+FROM build AS schema
+ENV PATH="${PATH}:/root/.dotnet/tools"
+RUN dotnet tool install --global dotnet-ef --version 8.0.8
+# Chỉ để khởi tạo host lúc sinh script; KHÔNG kết nối CSDL.
+ENV ConnectionStrings__Default="Server=localhost;Database=DiaCompanion;User Id=sa;Password=x;TrustServerCertificate=True" \
+    Jwt__SigningKey="design-time-only-design-time-only-design-time-only" \
+    Jwt__Issuer="design" Jwt__Audience="design" \
+    ASPNETCORE_ENVIRONMENT=Development DOTNET_CLI_TELEMETRY_OPTOUT=1
+RUN if [ -f DiaCompanion/Database/lite_schema.sql ]; then \
+        cp DiaCompanion/Database/lite_schema.sql /schema.sql; \
+    else \
+        dotnet ef dbcontext script --project DiaCompanion/DiaCompanion.csproj --output /schema.sql; \
+    fi \
+ && test -s /schema.sql && grep -q "Patients" /schema.sql
+
+############################ dbinit ###########################
+# Dùng chính image SQL Server làm nền để có sẵn sqlcmd (mssql-tools18).
+FROM mcr.microsoft.com/mssql/server:2022-latest AS dbinit
+USER root
+RUN apt-get update \
+ && apt-get install -y --no-install-recommends python3 \
+ && rm -rf /var/lib/apt/lists/*
+WORKDIR /init
+COPY --from=schema /schema.sql /init/schema.sql
+COPY Lite/seed_lite.py Lite/export_dataset.sql /init/
+COPY docker/backend/dbinit.sh /init/dbinit.sh
+RUN sed -i 's/\r$//' /init/dbinit.sh && chmod +x /init/dbinit.sh
+ENTRYPOINT ["/init/dbinit.sh"]
+CMD ["init"]
+
+############################ runtime ##########################
+FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
+WORKDIR /app
+COPY --from=build /app .
+# UID 1654 = người dùng "app" của image .NET 8; image AI dùng cùng UID để hai
+# container đọc/ghi chung volume ảnh.
+RUN mkdir -p /data/storage && chown -R 1654:1654 /data
+USER 1654
+ENV ASPNETCORE_URLS=http://+:8080 \
+    ASPNETCORE_ENVIRONMENT=Production \
+    DOTNET_gcServer=0
+EXPOSE 8080
+ENTRYPOINT ["dotnet", "DiaCompanion.dll"]
diff --git a/docker/backend/dbinit.sh b/docker/backend/dbinit.sh
new file mode 100755
index 0000000..3a81440
--- /dev/null
+++ b/docker/backend/dbinit.sh
@@ -0,0 +1,75 @@
+#!/usr/bin/env bash
+# Khởi tạo / bảo trì CSDL cho DiaCompanion Lite (chạy trong container dbinit).
+#   init             (mặc định) tạo DB → áp schema nếu DB trống → seed nếu chưa có tài khoản
+#   export           xuất bộ dữ liệu nghiên cứu (đã bỏ định danh) ra /exports/dataset.tsv
+#   reset-password   cấp lại mật khẩu tạm cho LITE_ADMIN_EMAIL
+set -euo pipefail
+
+: "${MSSQL_SA_PASSWORD:?Thiếu MSSQL_SA_PASSWORD}"
+DB_HOST="${DB_HOST:-db}"
+DB_NAME="${DB_NAME:-DiaCompanion}"
+EMAIL="${LITE_ADMIN_EMAIL:-nghiencuu@benhvien.local}"
+FULL_NAME="${LITE_ADMIN_NAME:-Nghiên cứu viên}"
+LICENSE="${LITE_LICENSE:-NCKH-001}"
+AI_DIR="${AI_DIR:-/ai_service}"
+
+# Email đi vào câu SQL: chỉ cho phép ký tự an toàn.
+if [[ ! "$EMAIL" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$ ]]; then
+  echo "LITE_ADMIN_EMAIL không hợp lệ: $EMAIL" >&2; exit 2
+fi
+
+SQLCMD=(/opt/mssql-tools18/bin/sqlcmd -C -b -S "$DB_HOST" -U sa -P "$MSSQL_SA_PASSWORD")
+q() { "${SQLCMD[@]}" -d "$DB_NAME" -h -1 -W -Q "SET NOCOUNT ON; $1" | tr -d '[:space:]'; }
+
+wait_db() {
+  echo "Chờ SQL Server ($DB_HOST)…"
+  for _ in $(seq 1 60); do
+    if "${SQLCMD[@]}" -Q "SELECT 1" >/dev/null 2>&1; then return 0; fi
+    sleep 3
+  done
+  echo "SQL Server không sẵn sàng sau 180 giây." >&2; exit 1
+}
+
+cmd="${1:-init}"
+wait_db
+
+case "$cmd" in
+  init)
+    "${SQLCMD[@]}" -Q "IF DB_ID(N'$DB_NAME') IS NULL CREATE DATABASE [$DB_NAME];"
+    if [ "$(q "SELECT COUNT(*) FROM sys.tables WHERE name = 'Patients'")" = "0" ]; then
+      echo "DB trống → áp schema…"
+      "${SQLCMD[@]}" -d "$DB_NAME" -f 65001 -i /init/schema.sql
+    else
+      echo "Schema đã có — bỏ qua."
+    fi
+    if [ "$(q "SELECT COUNT(*) FROM dbo.Users WHERE Email = N'$EMAIL'")" = "0" ]; then
+      echo "Chưa có tài khoản $EMAIL → seed…"
+      extra=()
+      [ "${ALLOW_MISSING_WEIGHTS:-0}" = "1" ] && extra+=(--allow-missing-weights)
+      python3 /init/seed_lite.py init --email "$EMAIL" --full-name "$FULL_NAME" --license "$LICENSE" \
+        --ai-service-dir "$AI_DIR" --out /tmp/lite_seed.sql --password-out /secrets/initial_credentials.txt "${extra[@]}"
+      "${SQLCMD[@]}" -d "$DB_NAME" -f 65001 -i /tmp/lite_seed.sql
+      rm -f /tmp/lite_seed.sql
+      echo "================================================================"
+      echo " Đăng nhập lần đầu: $EMAIL"
+      echo " Mật khẩu tạm (đổi ngay khi đăng nhập): xem ./secrets/initial_credentials.txt"
+      echo "================================================================"
+    else
+      echo "Tài khoản $EMAIL đã tồn tại — không seed lại."
+    fi
+    echo "dbinit hoàn tất."
+    ;;
+  export)
+    mkdir -p /exports
+    "${SQLCMD[@]}" -d "$DB_NAME" -f 65001 -W -s $'\t' -i /init/export_dataset.sql \
+      | sed -e '2d' -e '/rows affected/d' -e '/^$/d' > /exports/dataset.tsv
+    echo "Đã ghi /exports/dataset.tsv ($(wc -l < /exports/dataset.tsv) dòng gồm tiêu đề)."
+    ;;
+  reset-password)
+    python3 /init/seed_lite.py reset-password --email "$EMAIL" --out /tmp/lite_reset.sql --password-out /secrets/initial_credentials.txt
+    "${SQLCMD[@]}" -d "$DB_NAME" -f 65001 -i /tmp/lite_reset.sql
+    rm -f /tmp/lite_reset.sql
+    echo "Đã cấp lại mật khẩu tạm — xem ./secrets/initial_credentials.txt"
+    ;;
+  *) echo "Lệnh không hỗ trợ: $cmd (init | export | reset-password)" >&2; exit 2 ;;
+esac
diff --git a/docker/generate-env.ps1 b/docker/generate-env.ps1
new file mode 100644
index 0000000..bf7873a
--- /dev/null
+++ b/docker/generate-env.ps1
@@ -0,0 +1,23 @@
+# Sinh .env với mật khẩu/khóa ngẫu nhiên (Windows PowerShell 5.1+ / PowerShell 7).
+param([string]$AdminEmail = "nghiencuu@benhvien.local")
+$ErrorActionPreference = "Stop"
+Set-Location (Join-Path $PSScriptRoot "..")
+if (Test-Path .env) { Write-Error ".env đã tồn tại — không ghi đè."; exit 1 }
+function New-Rand([int]$n) {
+  $chars = [char[]]([char]'A'..[char]'Z' + [char]'a'..[char]'z' + [char]'0'..[char]'9')
+  $bytes = New-Object byte[] $n
+  [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
+  -join ($bytes | ForEach-Object { $chars[$_ % $chars.Length] })
+}
+$lines = @(
+  "MSSQL_SA_PASSWORD=Aa1$(New-Rand 21)",
+  "JWT_SIGNING_KEY=$(New-Rand 64)",
+  "LITE_ADMIN_EMAIL=$AdminEmail",
+  "LITE_ADMIN_NAME=Nghiên cứu viên",
+  "LITE_LICENSE=NCKH-001",
+  "WEB_PORT=8080",
+  "ALLOW_MISSING_WEIGHTS=0"
+)
+# UTF-8 không BOM để docker compose đọc đúng tiếng Việt.
+[System.IO.File]::WriteAllLines((Join-Path (Get-Location) ".env"), $lines, (New-Object System.Text.UTF8Encoding($false)))
+Write-Host "Đã tạo .env"
diff --git a/docker/generate-env.sh b/docker/generate-env.sh
new file mode 100755
index 0000000..b72d879
--- /dev/null
+++ b/docker/generate-env.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+# Sinh .env với mật khẩu/khóa ngẫu nhiên (chỉ ký tự chữ + số để an toàn trong chuỗi kết nối).
+set -euo pipefail
+cd "$(dirname "$0")/.."
+[ -e .env ] && { echo ".env đã tồn tại — không ghi đè." >&2; exit 1; }
+# head đóng ống sớm → tr nhận SIGPIPE; tắt pipefail trong hàm này.
+rand() ( set +o pipefail; LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c "$1" )
+sa="Aa1$(rand 21)"
+{
+  echo "MSSQL_SA_PASSWORD=$sa"
+  echo "JWT_SIGNING_KEY=$(rand 64)"
+  echo "LITE_ADMIN_EMAIL=${1:-nghiencuu@benhvien.local}"
+  echo "LITE_ADMIN_NAME=Nghiên cứu viên"
+  echo "LITE_LICENSE=NCKH-001"
+  echo "WEB_PORT=8080"
+  echo "ALLOW_MISSING_WEIGHTS=0"
+} > .env
+chmod 600 .env
+echo "Đã tạo .env"
