# Sao chép thành .env rồi sửa. (Hoặc chạy docker/generate-env.ps1 / docker/generate-env.sh để tự sinh.)

# Mật khẩu tài khoản sa của SQL Server: ≥ 8 ký tự, có chữ hoa, chữ thường, số.
# Chỉ dùng chữ + số để khỏi hỏng chuỗi kết nối.
MSSQL_SA_PASSWORD=ChangeMe123Strong

# Khóa ký JWT: chuỗi ngẫu nhiên dài (≥ 48 ký tự).
JWT_SIGNING_KEY=replace-with-a-long-random-string-at-least-48-characters

# Tài khoản LÂM SÀNG tạo lần đầu (có cả hai vai trò Doctor + Receptionist: bác sĩ làm tất cả).
LITE_ADMIN_EMAIL=bacsi@benhvien.local
LITE_ADMIN_NAME=Bác sĩ
LITE_LICENSE=NCKH-001

# Tài khoản NGHIÊN CỨU (vai trò Research: chỉ tải dataset CSV, không xem hồ sơ bệnh nhân).
# Để trống nếu không cần.
LITE_RESEARCH_EMAIL=nghiencuu@benhvien.local

# Cổng web trên máy chủ.
WEB_PORT=8080

# 1 = cho phép khởi tạo khi CHƯA có trọng số AI (chỉ để thử giao diện; AI sẽ báo lỗi).
ALLOW_MISSING_WEIGHTS=0
